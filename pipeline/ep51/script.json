 "segments": [
  {
   "id": "hook1",
   "text": "You're starving. You pull up to the drive-through window.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "The window opens. And out comes a T-rex. In a paper hat. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers shout: the biggest burger you've got!",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. A T-rex takes every order very literally. And the biggest thing here is your car.",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "Bun. Cheese. Ketchup. One giant car burger. To go.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Order nicely. Then spot the problem. Tiny arms. She can't reach your window.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "So hand her your barbecue tongs. Every good driver carries some.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "Now she can reach. Burger. Fries. And a tiny high five.",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "She's so happy, she does a little dance. The whole restaurant wiggles.",
   "gap": 0.5
  },
  {
   "id": "right6",
   "text": "Free dessert. Extra large.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: the petrol pump is an elephant. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
