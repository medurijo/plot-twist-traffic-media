 "segments": [
  {"id": "hook1", "text": "Your car is filthy. So you drive into the car wash.", "gap": 0.4},
  {"id": "hook2", "text": "But then the brushes open an eye. It's a giant octopus. What do you do?", "gap": 0.9},
  {"id": "wrong1", "text": "Most drivers leave the window open. Just a crack.", "gap": 0.4},
  {"id": "wrong2", "text": "Big mistake. One arm slips in. Then two. Then all eight.", "gap": 0.4},
  {"id": "wrong3", "text": "Splash! The whole car fills up with foam. You come out with a bubble hairdo. And the outside? Still filthy.", "gap": 0.9},
  {"id": "wrong4", "text": "Exam failed.", "gap": 1.15},
  {"id": "right1", "text": "Here's how you do it properly.", "gap": 0.3},
  {"id": "right2", "text": "Close every window. And turn up the music.", "gap": 0.4},
  {"id": "right3", "text": "The octopus loves it. Eight arms. Eight sponges. Perfect rhythm.", "gap": 0.4},
  {"id": "right4", "text": "Wheels. Roof. Bonnet. And a little heart on the windscreen.", "gap": 0.4},
  {"id": "right5", "text": "Then it dries you off. With one big puff.", "gap": 0.5},
  {"id": "right6", "text": "Spotless car. Happy octopus.", "gap": 0.6},
  {"id": "right7", "text": "Exam passed.", "gap": 1.3},
  {"id": "outro", "text": "Next exam question: the parking barrier is a giraffe. Follow, so you don't miss it.", "gap": 1.2}
 ],
