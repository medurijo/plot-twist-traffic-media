 "segments": [
  {
   "id": "hook1",
   "text": "Mountain road. One little tunnel. And from inside comes a very loud snore.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "A dragon is sleeping in the tunnel. And every snore is a fireball. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers honk. Wake it up, and it will move. Right?",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. Nobody likes being woken up. Especially not a dragon.",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "One grumpy yawn, and your car is toast. Then it grabs the nearest teddy bear. Your car. And goes back to sleep. For a hundred years.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Engine off. Lights off. And fluffy socks on all four wheels.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "Now tiptoe past its nose. Right between two snores.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "Uh-oh. It's waking up. Quick: radio on. Lullaby station.",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "The dragon smiles, snuggles in, and snores out little heart-shaped smoke rings.",
   "gap": 0.5
  },
  {
   "id": "right6",
   "text": "Tunnel clear. Socks only slightly toasted.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: a giant hen drives the tractor. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
