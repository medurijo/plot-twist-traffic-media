 "segments": [
  {
   "id": "hook1",
   "text": "Parallel parking. Find a gap, indicate, and reverse in slowly.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "Perfect gap. Just one problem: in front and behind, there's a sleeping bear. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers just reverse in, with the parking sensor on.",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. Beep. Beep. Beeeeep! The bear thinks it's his alarm clock.",
   "gap": 0.4
  },
  {
   "id": "wrong3",
   "text": "So he hits snooze. Splat! Then your car alarm goes off. Snooze again! Splat! And now, your car is his new pillow.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Turn off the sensor. Then give each bear a teddy.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "They hug it, and roll out of your way.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "Now switch on tiptoe mode, and sneak in. One tiny step at a time.",
   "gap": 0.5
  },
  {
   "id": "right5",
   "text": "Now lock it. Quietly. Beep. Oops. He opens one eye. And goes back to sleep.",
   "gap": 0.6
  },
  {
   "id": "right6",
   "text": "Shh. Parked.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: a fire-breather at the petrol station. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
