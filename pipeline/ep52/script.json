 "segments": [
  {
   "id": "hook1",
   "text": "Fuel light's on. You pull up to pump number three.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "You grab the hose. It's warm. And it just sniffed you. It's an elephant. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers grab the trunk, and squeeze hard.",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. That's her nose. And when you squeeze a nose, it sneezes.",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "Ah. Ah. Achoo! Your car is now parked on the roof. Next to the prices.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Read the sign on the pump. Payment: peanuts only.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "So put one peanut on your fuel cap. And wait.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "She sniffs it, finds the tank, and fills you up. With a happy trumpet.",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "Then she gives your car a free wash. Trunk shower included.",
   "gap": 0.5
  },
  {
   "id": "right6",
   "text": "Full tank. Clean car. And a rainbow. All for one peanut.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: the lollipop lady is a snowman. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
