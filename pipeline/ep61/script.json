 "segments": [
  {
   "id": "hook1",
   "text": "Red light. Middle of the night. Nobody around. You wait. And wait.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "Then the red light blinks. It's an eye. The traffic light is an owl. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers think: nobody's watching. And drive straight through.",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. Owls see everything. Her head turns. All the way round.",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "She swoops down, grabs your car like a mouse, and flies it home to her nest. Now she's sitting on you. She thinks you're an egg.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Stop at the line. Owls love good manners. And they love winking.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "So you wink at her. With your headlight. Blink.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "She blushes, and winks back. Red eye closed. Green eye open. Green light!",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "And she likes you so much, she flies along, and lights up the whole road for you.",
   "gap": 0.4
  },
  {
   "id": "right6",
   "text": "Two giant headlights. Hoo hoo!",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: a tornado takes the car in front of you. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
