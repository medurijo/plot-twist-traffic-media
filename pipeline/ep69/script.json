 "segments": [
  {
   "id": "hook1",
   "text": "Motorway. Twelve o'clock. Not a cloud in the sky. Then something takes a bite out of the sun.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "It's a total eclipse. In ten seconds, it's pitch dark. And you're doing a hundred and twenty. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers think: full beam! Light up the sky!",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. You dazzle the moon. It blinks. And it loses its grip.",
   "gap": 0.4
  },
  {
   "id": "wrong3",
   "text": "It drops onto the motorway, bounces, and rolls right after you. Squash. Your car is now a crater on the moon.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Slow down. Dipped headlights on. And keep your distance.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "Everyone does the same. And from above, the motorway turns into a string of fairy lights.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "The moon looks down. It has never seen anything so beautiful.",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "It blushes. And slowly slides away. The sun is back.",
   "gap": 0.4
  },
  {
   "id": "right6",
   "text": "And the moon gives you a little wink. See you tonight.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: a rocket launch, right next to the traffic jam. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
