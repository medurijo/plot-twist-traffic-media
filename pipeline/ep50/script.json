 "segments": [
  {
   "id": "hook1",
   "text": "Country road. A slow tractor ahead. You want to overtake.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "But the farmer is a giant hen. And the trailer is full of eggs. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers honk, and squeeze past.",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. When a hen gets a fright, she lays eggs. Lots of eggs. Very fast.",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "Splat. Splat. Splat. And your bonnet is hot. Your car is now breakfast. Sunny side up.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Stay back. Then flap your wipers. Twice.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "In chicken, that means: may I pass, please?",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "The hen nods, signals with her wing, and pulls over.",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "As you pass, she waves. And drops a thank-you egg through your sunroof.",
   "gap": 0.5
  },
  {
   "id": "right6",
   "text": "Crack! Road clear. And a brand new co-driver.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: a T-rex runs the drive-through. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
