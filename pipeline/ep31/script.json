 "segments": [
  {
   "id": "hook1",
   "text": "There's a speed camera ahead. But this one is a little different.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "It's a fashion photographer. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers speed up, and strike a pose. Flash!",
   "gap": 0.5
  },
  {
   "id": "wrong2",
   "text": "Big mistake. Gorgeous, darling! Again! Faster! So you turn around and race past again. And again. Flash! Flash! Flash!",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "A week later, you're on a magazine cover. Speeder of the year. And inside? The fine. Four thousand euros. And your licence? Gone.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Stick to the speed limit. Calm, steady, both hands on the wheel.",
   "gap": 0.5
  },
  {
   "id": "right3",
   "text": "The photographer is bored at first. But then it's so impressed, it jumps off its pole and runs after you on its tiny legs.",
   "gap": 0.5
  },
  {
   "id": "right4",
   "text": "It wants your autograph. So you stop, and sign its flash.",
   "gap": 0.6
  },
  {
   "id": "right5",
   "text": "It sticks your autograph right on its lens. Now it can't see a thing. But it doesn't care.",
   "gap": 0.6
  },
  {
   "id": "right6",
   "text": "Biggest fan ever.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: the road is a giant treadmill. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
