 "segments": [
  {
   "id": "hook1",
   "text": "You're crossing the old bridge into town. Halfway across, a bell starts ringing.",
   "gap": 0.4
  },
  {
   "id": "hook2",
   "text": "The barriers come down. Behind you. The bridge is opening. With you on it. What do you do?",
   "gap": 0.9
  },
  {
   "id": "wrong1",
   "text": "Most drivers think: full throttle. Jump it, like in the movies.",
   "gap": 0.4
  },
  {
   "id": "wrong2",
   "text": "Big mistake. The ramp gets steeper and steeper. And you fly. Really high.",
   "gap": 0.5
  },
  {
   "id": "wrong3",
   "text": "Over the river, and right into the swimming pool of a cruise ship. Splash. Next stop: Australia.",
   "gap": 0.9
  },
  {
   "id": "wrong4",
   "text": "Exam failed.",
   "gap": 1.15
  },
  {
   "id": "right1",
   "text": "Here's how you do it properly.",
   "gap": 0.3
  },
  {
   "id": "right2",
   "text": "Stop. Engine off. Handbrake on. Hold on to your coffee.",
   "gap": 0.4
  },
  {
   "id": "right3",
   "text": "Up you go. Best view in town.",
   "gap": 0.4
  },
  {
   "id": "right4",
   "text": "The cruise ship glides past underneath. Everybody waves. The captain salutes, and sounds the horn, just for you.",
   "gap": 0.4
  },
  {
   "id": "right5",
   "text": "He's so impressed, he throws you his captain's hat.",
   "gap": 0.4
  },
  {
   "id": "right6",
   "text": "The bridge comes down. And you drive into town, as captain of the road.",
   "gap": 0.6
  },
  {
   "id": "right7",
   "text": "Exam passed.",
   "gap": 1.3
  },
  {
   "id": "outro",
   "text": "Next exam question: the traffic light turns into a disco. Follow, so you don't miss it.",
   "gap": 1.2
  }
 ],
