 "segments": [
  {"id": "hook1", "text": "Traffic jam on the motorway. Then you hear a siren.", "gap": 0.4},
  {"id": "hook2", "text": "But it's not an ambulance. It's an ice-cream van. And its emergency? It's all melting. What do you do?", "gap": 0.9},
  {"id": "wrong1", "text": "Most drivers don't move over. They just wave, and order a cone.", "gap": 0.4},
  {"id": "wrong2", "text": "Big mistake. The van gets stuck. The sun gets hotter. And the freezer gives up.", "gap": 0.4},
  {"id": "wrong3", "text": "Boom! A giant wave of melted ice cream floods the motorway. Now you're stuck in a milkshake. With sprinkles.", "gap": 0.9},
  {"id": "wrong4", "text": "Exam failed.", "gap": 1.15},
  {"id": "right1", "text": "Here's how you do it properly.", "gap": 0.3},
  {"id": "right2", "text": "Make an emergency lane. Left lane goes left. Right lane goes right.", "gap": 0.4},
  {"id": "right3", "text": "The van zooms through. And to say thank you, it fires a cone at every car.", "gap": 0.4},
  {"id": "right4", "text": "Strawberry. Chocolate. Pistachio. Every car gets a party hat.", "gap": 0.4},
  {"id": "right5", "text": "Even the lorry gets one. Extra large.", "gap": 0.5},
  {"id": "right6", "text": "Emergency over. Nothing melted.", "gap": 0.6},
  {"id": "right7", "text": "Exam passed.", "gap": 1.3},
  {"id": "outro", "text": "Next exam question: the car wash is a giant octopus. Follow, so you don't miss it.", "gap": 1.2}
 ],
